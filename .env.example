# Maren Beauty — environment variables
#
# Copy to `.env.local` and fill in. Never commit real values (CLAUDE.md §17).
# `src/config/env.ts` (M2) parses these once with Zod and throws at startup on a
# missing required value, so a misconfigured deploy fails loudly rather than
# serving a broken form.

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin. Apex, not www (docs/OPEN-QUESTIONS.md C2).
SITE_URL=https://marenbeauty.com

# ── Mail (M11) ──────────────────────────────────────────────────────────────
# Google Workspace SMTP. Node runtime only — Edge cannot open SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP_USER, MAIL_FROM and MAIL_TO are deliberately the SAME address
# (docs/OPEN-QUESTIONS.md B1). One mailbox, one identity, no send-as alias —
# so the authenticated account and the From header always align and SPF/DKIM
# pass with no extra configuration.
SMTP_USER=info@marenbeauty.com
MAIL_FROM=info@marenbeauty.com
MAIL_TO=info@marenbeauty.com

# App password on the info@ account; requires 2FA (docs/OPEN-QUESTIONS.md B3).
# SECRET. Not used for bulk mail.
SMTP_PASS=

# ── Spam protection (M11) ───────────────────────────────────────────────────
# Altcha proof-of-work signing key. SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALTCHA_HMAC_KEY=

# ── Analytics (M14) — UNUSED AT LAUNCH ──────────────────────────────────────
# No analytics backend is deployed at launch (docs/OPEN-QUESTIONS.md C5):
# no Umami instance, no VPS, no DNS record. The consent gate still ships live
# with every tag off (C6), so tracking can never start before consent exists.
#
# These are OPTIONAL. `env.ts` does not require them; a missing value is not a
# startup failure. Leave blank until analytics is actually switched on.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
