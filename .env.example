# Maren Beauty — environment variables
#
# Copy to `.env.local` and fill in. Never commit real values (CLAUDE.md §17).
# `src/config/env.ts` (M2) parses these once with Zod and throws at startup on a
# missing required value, so a misconfigured deploy fails loudly rather than
# serving a broken form.

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin. Apex, not www (docs/OPEN-QUESTIONS.md C2).
SITE_URL=https://marenbeauty.com

# ── Legal entity (M12) ──────────────────────────────────────────────────────
# The ünvan of the business, named as the data controller on the three legal
# pages. It has never been invented and must not be (B2).
#
# ⚠️ BUILD-TIME, NOT RUNTIME. The legal pages are statically prerendered, so
# this is read during `next build` and baked into the HTML. Setting it only at
# run time does nothing — the pages will still say the ünvan is pending.
#   Vercel   — exposes project env vars to the build. Nothing extra to do.
#   Docker   — pass it explicitly:
#              docker build --build-arg LEGAL_ENTITY="…" -t marenbeauty .
#
# While unset, the three legal pages name no entity and say so. That is the
# correct unresolved state, and `npm run preflight` refuses a production deploy
# in it — so "unresolved" reaches a local build and CI but never a live site.
#
# CURRENT VALUE IS PROVISIONAL (2026-08-07): "Maren Beauty Center Limited
# Şirketi", supplied by the owner while the company is still being registered.
# It must be replaced with the registered ünvan after incorporation — B2 is
# open for exactly that.
LEGAL_ENTITY=

# ── Mail (M11) ──────────────────────────────────────────────────────────────
# `smtp` (default) or `capture`.
#
# `capture` composes the identical message and hands it to an in-memory outbox
# instead of opening a socket, readable at /api/dev/outbox. It is how the send
# path is verified while the credential does not exist yet, and `env.ts`
# REFUSES it in production — a deployment that swallows every enquiry is worse
# than one that fails loudly. Leave this unset unless you are testing locally.
MAIL_TRANSPORT=smtp

# Google Workspace SMTP. Node runtime only — Edge cannot open SMTP.
# Needed only to SEND. The contact page renders and validates without these;
# the failure is confined to delivery (docs/OPEN-QUESTIONS.md G22).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP_USER, MAIL_FROM and MAIL_TO are deliberately the SAME address
# (docs/OPEN-QUESTIONS.md B1). One mailbox, one identity, no send-as alias —
# so the authenticated account and the From header always align and SPF/DKIM
# pass with no extra configuration.
SMTP_USER=info@marenbeauty.com
MAIL_FROM=info@marenbeauty.com
MAIL_TO=info@marenbeauty.com

# App password on the info@ account; requires 2FA (docs/OPEN-QUESTIONS.md B3).
# SECRET. Not used for bulk mail.
SMTP_PASS=

# ── Spam protection (M11) ───────────────────────────────────────────────────
# Altcha proof-of-work signing key, also used for the no-JS page token. SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# REQUIRED IN PRODUCTION — the contact page cannot render its form token
# without it. Outside production an absent key becomes a random per-process one
# with a loud warning, so `npm run dev` works out of the box; a per-instance key
# would break verification the moment production had two instances.
ALTCHA_HMAC_KEY=

# ── Analytics (M14) — UNUSED AT LAUNCH ──────────────────────────────────────
# No analytics backend is deployed at launch (docs/OPEN-QUESTIONS.md C5):
# no Umami instance, no VPS, no DNS record. The consent machinery still ships
# live with every tag off (C6), so tracking can never start before consent
# exists.
#
# ALL FOUR ARE OPTIONAL. `env.ts` does not require them; a missing value is not
# a startup failure. Leave blank until analytics is actually switched on.
#
# Umami is cookieless and needs no consent — it is wired and simply renders
# nothing while the flag is off. GA4 and the Meta Pixel are NOT imported by the
# build at all, so no tracker code ships; turning one on is documented at the
# top of src/components/analytics/Analytics.tsx.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Only read once the matching flag in src/config/analytics.ts is true.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
