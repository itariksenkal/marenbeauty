{
  "name": "marenbeauty",
  "version": "0.1.0",
  "private": true,
  "description": "Maren Beauty — boutique beauty centre, Konya / Selçuklu",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "guard": "node scripts/guard.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test": "vitest run",
    "test:a11y": "node scripts/stub.mjs test:a11y \"axe + Playwright arrive at M15\"",
    "licenses": "node scripts/licenses.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run fonts && npm run build && npm run guard && npm run test && npm run test:e2e && npm run test:a11y && npm run licenses",
    "fonts": "node scripts/verify-fonts.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/free-ports.mjs",
    "posttest:e2e": "node scripts/free-ports.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "altcha-lib": "2.3.2",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "motion": "13.0.0",
    "next": "16.3.0",
    "nodemailer": "9.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
