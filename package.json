{
  "name": "marenbeauty",
  "version": "0.1.0",
  "private": true,
  "description": "Maren Beauty — boutique beauty centre, Konya / Selçuklu",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "guard": "node scripts/guard.mjs",
    "test": "node scripts/stub.mjs test \"unit tests arrive at M4\"",
    "test:a11y": "node scripts/stub.mjs test:a11y \"axe + Playwright arrive at M15\"",
    "licenses": "node scripts/licenses.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run fonts && npm run build && npm run guard && npm run test && npm run test:a11y && npm run licenses",
    "fonts": "node scripts/verify-fonts.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
